# Template only - copy to .env and fill in real values.
# NEVER put real keys in this file; it is committed to git.

# Supabase - Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable / anon key - safe in the browser (RLS applies).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Secret / service_role key - bypasses RLS. SERVER ONLY, never in client code.
# Must be the Secret key (sb_secret_...) or legacy service_role key,
# NOT the publishable key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Razorpay - Dashboard > Settings > API Keys
# Only needed when online payment is switched back on; checkout currently
# runs as Cash on Delivery (CheckoutButton -> POST /api/orders).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
# Public key id used by the browser checkout widget (same value as RAZORPAY_KEY_ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Base URL (used for redirects); optional in dev
NEXT_PUBLIC_BASE_URL=http://localhost:5173
